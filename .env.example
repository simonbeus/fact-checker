# ==========================================
# Fact-Checking API Configuration
# ==========================================

# Mistral AI API Key (required for Pydantic-AI agent)
MISTRAL_API_KEY=your_mistral_api_key_here

# Tavily Search API Key (required for trusted evidence retrieval)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Mistral Model Name (e.g., mistral-large-latest, mistral-small-latest)
MISTRAL_MODEL_NAME=mistral-large-latest

# Application Server Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
